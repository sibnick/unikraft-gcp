CONFIG_ARCH_X86_64=y
CONFIG_PLAT_KVM=y
CONFIG_KVM_VMM_QEMU=y
CONFIG_KVM_BOOT_PROTO_MULTIBOOT=y
CONFIG_KVM_PCI=y
CONFIG_LIBUKBOOT=y
CONFIG_LIBUKBOOT_BANNER_POWEREDBY=y
# Keep driver and kernel INFO diagnostics on the serial console. The
# ukprint default is ERR only, which hides gve probe diagnostics that
# the evidence contract relies on. Ticket c1a76baff0.
CONFIG_LIBUKPRINT_KLVL_INFO=y
CONFIG_LIBUKCONSOLE=y
CONFIG_LIBNS16550=y
CONFIG_LIBNS16550_EARLY_CONSOLE=y
CONFIG_LIBNS16550_COM_AVAIL=y
CONFIG_LIBNS16550_COM1=y
CONFIG_LIBNS16550_COM1_BAUD_115200=y
CONFIG_LIBNS16550_COM1_EARLY=y
CONFIG_LIBUKDEBUG=y
CONFIG_LIBUKDEBUG_PRINTK=y
CONFIG_LIBUKDEBUG_PRINTK_INFO=y
CONFIG_LIBUKALLOC=y
CONFIG_LIBUKALLOCBBUDDY=y
CONFIG_LIBUKBUS=y
CONFIG_LIBUKBUS_PCI=y
CONFIG_LIBUKNETDEV=y
CONFIG_LIBUKNETDEV_EINFO_LIBPARAM=y
CONFIG_LIBUKLIBPARAM=y
CONFIG_LIBVIRTIO_BUS=y
CONFIG_LIBVIRTIO_PCI=y
CONFIG_LIBVIRTIO_NET=y
CONFIG_LIBGVE=y
CONFIG_LIBNOLIBC=y
CONFIG_LIBPOSIX_POLL=y
CONFIG_LIBPOSIX_SOCKET=y
CONFIG_LIBPOSIX_SOCKET_POLLED=y
CONFIG_LIBPOSIX_TIME=y
CONFIG_LIBLWIP=y
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_NOTHREADS=y
CONFIG_LWIP_PERCORE=y
CONFIG_LWIP_SOCKET=y
# LWIP_TCP stays on even for the UDP server: the lwIP port's timer
# pool budget and auto-iface path assume it. A TCP-less build crashes
# at boot with MEMP_SYS_TIMEOUT empty. Same set as networkload.
CONFIG_LWIP_TCP=y
CONFIG_LWIP_UDP=y
CONFIG_LWIP_ICMP=y
CONFIG_LWIP_POOLS=y
CONFIG_LWIP_AUTOIFACE=y
CONFIG_UK_DEFNAME="hft-server"
CONFIG_UK_NAME="hft-server"
CONFIG_APPLOWLATENCYHFT=y
