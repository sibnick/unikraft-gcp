CONFIG_ARCH_X86_64=y
CONFIG_PLAT_KVM=y
CONFIG_KVM_VMM_QEMU=y
CONFIG_KVM_BOOT_PROTO_MULTIBOOT=y
CONFIG_KVM_PCI=y
# SMP: one worker core per vCPU. The run scripts match the VM vCPU
# count to this value. UKPLAT_CPU_MAXCOUNT switches HAVE_SMP on.
CONFIG_UKPLAT_CPU_MAXCOUNT=4
CONFIG_LIBUKLCPU=y
CONFIG_LIBUKPCPUVAR=y
CONFIG_LIBUKBOOT=y
CONFIG_LIBUKBOOT_BANNER_POWEREDBY=y
CONFIG_LIBUKBOOT_MAINTHREAD=y
CONFIG_LIBUKBOOT_PERCORE_HEAP=y
# Keep driver and kernel INFO diagnostics on the serial console, the
# same reason as samples/httpreply (ticket c1a76baff0). The per-core
# boot lines are gate evidence.
CONFIG_LIBUKPRINT_KLVL_INFO=y
CONFIG_LIBUKCONSOLE=y
CONFIG_LIBNS16550=y
CONFIG_LIBNS16550_EARLY_CONSOLE=y
CONFIG_LIBNS16550_COM_AVAIL=y
CONFIG_LIBNS16550_COM1=y
CONFIG_LIBNS16550_COM1_BAUD_115200=y
CONFIG_LIBNS16550_COM1_EARLY=y
CONFIG_LIBUKDEBUG=y
CONFIG_LIBUKDEBUG_PRINTK=y
CONFIG_LIBUKDEBUG_PRINTK_INFO=y
CONFIG_LIBUKALLOC=y
CONFIG_LIBUKALLOCBBUDDY=y
CONFIG_LIBUKBUS=y
CONFIG_LIBUKBUS_PCI=y
CONFIG_LIBUKNETDEV=y
CONFIG_LIBUKNETDEV_MAXNBQUEUES=4
CONFIG_LIBUKNETDEV_EINFO_LIBPARAM=y
CONFIG_LIBUKLIBPARAM=y
CONFIG_LIBUKSCHED=y
CONFIG_LIBUKSCHEDCOOP=y
CONFIG_LIBUKLOCK=y
CONFIG_LIBVIRTIO_BUS=y
CONFIG_LIBVIRTIO_PCI=y
CONFIG_LIBVIRTIO_NET=y
CONFIG_LIBGVE=y
CONFIG_LIBNOLIBC=y
CONFIG_LIBPOSIX_POLL=y
CONFIG_LIBPOSIX_SOCKET=y
CONFIG_LIBPOSIX_SOCKET_POLLED=y
CONFIG_LIBPOSIX_TIME=y
CONFIG_LIBLWIP=y
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_TCP=y
CONFIG_LWIP_NOTHREADS=y
CONFIG_LWIP_PERCORE=y
CONFIG_LWIP_SOCKET=y
CONFIG_LWIP_ICMP=y
CONFIG_LWIP_AUTOIFACE=y
# HTTP benchmark sizing from the Unikraft-ENA httpreply-mc sample:
# many short-lived keep-alive connections spread over the cores.
CONFIG_LWIP_NUM_TCPCON=1024
CONFIG_LWIP_NUM_TCPLISTENERS=256
CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_RCVBUF=y
CONFIG_LWIP_POOLS=y
CONFIG_UK_DEFNAME="httpreply-mc"
CONFIG_UK_NAME="httpreply-mc"
CONFIG_APPHTTPREPLYMC=y
CONFIG_APPHTTPREPLYMC_CONSOLE_STATS=y
CONFIG_OPTIMIZE_PERF=y
CONFIG_OPTIMIZE_LTO=y
