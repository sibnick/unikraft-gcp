config APPNETWORKLOAD_DEPENDENCIES
	bool
	default y
	select LIBNOLIBC if !HAVE_LIBC
	select LIBUKALLOC
	select LIBUKBUS
	select LIBUKBUS_PCI
	select LIBUKNETDEV
	select LIBUKNETDEV_EINFO_LIBPARAM
	select LIBLWIP
	select LIBLWIP_IPV4
	select LIBLWIP_NOTHREADS
	select LIBLWIP_SOCKET
	select LIBLWIP_UDP
	select LIBLWIP_TCP
	select LIBLWIP_ICMP
	select LIBLWIP_RAW
	select LIBLWIP_AUTOIFACE
	select LIBPOSIX_POLL
	select LIBPOSIX_SOCKET_POLLED
	select LIBPOSIX_TIME

menuconfig APPNETWORKLOAD
	bool "Networkload traffic and throughput benchmark"
	default y
	select APPNETWORKLOAD_DEPENDENCIES
