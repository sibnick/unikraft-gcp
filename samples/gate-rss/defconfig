CONFIG_ARCH_X86_64=y
CONFIG_PLAT_KVM=y
CONFIG_KVM_VMM_QEMU=y
CONFIG_KVM_BOOT_PROTO_MULTIBOOT=y
CONFIG_KVM_PCI=y
CONFIG_LIBUKBOOT=y
CONFIG_LIBUKBOOT_BANNER_POWEREDBY=y
# Keep driver and kernel INFO diagnostics on the serial console. The
# ukprint default is ERR only, which hides gve probe diagnostics that
# the evidence contract relies on. Ticket c1a76baff0.
CONFIG_LIBUKPRINT_KLVL_INFO=y
CONFIG_LIBUKCONSOLE=y
CONFIG_LIBNS16550=y
CONFIG_LIBNS16550_EARLY_CONSOLE=y
CONFIG_LIBNS16550_COM_AVAIL=y
CONFIG_LIBNS16550_COM1=y
CONFIG_LIBNS16550_COM1_BAUD_115200=y
CONFIG_LIBNS16550_COM1_EARLY=y
CONFIG_LIBUKDEBUG=y
CONFIG_LIBUKDEBUG_PRINTK=y
CONFIG_LIBUKDEBUG_PRINTK_INFO=y
CONFIG_LIBUKALLOC=y
CONFIG_LIBUKALLOCBBUDDY=y
CONFIG_LIBUKBUS=y
CONFIG_LIBUKBUS_PCI=y
CONFIG_LIBUKNETDEV=y
# The gate runs up to 4 queue pairs on a c3-standard-4 device. The
# core default of 1 would reject any multi-queue configure. Ticket
# a9b1936640.
CONFIG_LIBUKNETDEV_MAXNBQUEUES=8
CONFIG_LIBVIRTIO_BUS=y
CONFIG_LIBVIRTIO_PCI=y
CONFIG_LIBVIRTIO_NET=y
CONFIG_LIBGVE=y
CONFIG_LIBNOLIBC=y
CONFIG_UK_DEFNAME="gate_rss"
CONFIG_UK_NAME="gate_rss"
CONFIG_APPGATERSS=y
