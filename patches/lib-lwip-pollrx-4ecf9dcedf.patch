+		 * enabled, so there is nothing to disable here.
+		 */
+		if (uk_netdev_rxintr_supported(lwip_data->dev_info.features)
+		    && !CONFIG_LWIP_UKNETDEV_POLLRX) {
 			uk_netdev_rxq_intr_disable(dev, 0);
 			LWIP_DEBUGF(NETIF_DEBUG,
