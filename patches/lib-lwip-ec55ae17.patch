 	.ioctl		= lwip_posix_socket_ioctl,
+#if CONFIG_LIBPOSIX_SOCKET_POLLED
+	.poll		= lwip_posix_socket_poll,
+#endif /* CONFIG_LIBPOSIX_SOCKET_POLLED */
 	.poll_setup	= lwip_posix_socket_poll_setup,
