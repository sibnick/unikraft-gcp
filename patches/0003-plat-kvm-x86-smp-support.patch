+	if (!uk_load_n(&ent->on_ready))
+		return;
+	epoll_ready_drain(al);
+	for (p = &al->ready; *p; p = &(*p)->ready_next) {
+		if (*p == ent) {
+			*p = ent->ready_next;
+			break;
+		}
+	}
+	uk_store_n(&ent->on_ready, 0);
+	ent->ready_next = NULL;
