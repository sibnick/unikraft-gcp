+++ b/diag.c
@@ -0,0 +1,308 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * TEMP DIAG (unikraft-gcp ticket 4ecf9dcedf).
+ *
+ * Periodic network forensics printer for the nginx-on-GCP
+ * investigation. One kernel thread wakes every 10 seconds and prints
+ * to the serial console:
+ *
+ *   - RX and TX counters taken from the uknetdev glue data path;
+ *   - lwIP pool occupancy, which shows whether the ARP pending queue
+ *     is stuck;
+ *   - the netif state and the result of the lwip.diagpeers=<ipv4>
+ *     boot parameter.
+ *
+ * The counters are the discriminator the run needs. When the RX
+ * counter advances while the client sends SYNs, but nginx never
+ * accepts, the break is between the ring and the stack. When the RX
+ * counter stays flat under load, the frames never reach the guest or
+ * the reply path is dead. Remove this file with the LWIP_UKG_DIAG
+ * option when the investigation ends.
+ */
+
+#include <uk/config.h>
+
+#if CONFIG_LWIP_UKG_DIAG
+
+#include <stdio.h>
+#include <string.h>
+#include <inttypes.h>
+
+#include <uk/print.h>
+#include <uk/essentials.h>
+#include <uk/arch/time.h>
+#include <uk/plat/time.h>
+#include <uk/semaphore.h>
+#include <uk/sched.h>
+#include <uk/init.h>
+#include <uk/libparam.h>
+
+#include "lwip/opt.h"
+#include "lwip/init.h"
+#include "lwip/netif.h"
+#include "lwip/ip_addr.h"
+#include "lwip/etharp.h"
+#include "lwip/stats.h"
+#include "lwip/memp.h"
+#include "lwip/tcp.h"
+#include "lwip/tcpbase.h"
+#include "lwip/priv/tcp_priv.h"
+#include "arch/sys_arch.h"
+
+#include "ukg_diag.h"
+
+/* Boot argument: lwip.diagpeers=<ipv4>, repeated up to
+ * UKG_DIAG_MAXPEERS times. The GCP fabric does not answer ARP
+ * requests for guest IPs on the legacy virtio-net path, so map each
+ * peer to the gateway-derived MAC 42:01:<gateway ip bytes>. Same rule
+ * as the C1 httpreply gates (ticket 73b23402f0). */
+#define UKG_DIAG_MAXPEERS 8
+static char *diagpeers[UKG_DIAG_MAXPEERS];
+UK_LIBPARAM_PARAM_ARR_ALIAS(diagpeers, diagpeers, charp, UKG_DIAG_MAXPEERS,
+			    "Static ARP peers (TEMP DIAG 4ecf9dcedf)");
+
+#define UKG_DIAG_PERIOD_SEC 10
+
+static struct uk_semaphore nap;
+
+static void ukg_diag_print_pools(void)
+{
+#if LWIP_STATS && MEMP_STATS
+	static const struct {
+		int idx;
+		const char *name;
+	} pools[] = {
+#if PBUF_POOL_SIZE
+		{ MEMP_PBUF_POOL, "PBUF_POOL" },
+#endif
+		{ MEMP_PBUF, "PBUF" },
+#if LWIP_TCP
+		{ MEMP_TCP_PCB, "TCP_PCB" },
+		{ MEMP_TCP_PCB_LISTEN, "TCP_LSN" },
+#if TCP_QUEUE_OOSEQ
+		{ MEMP_TCP_SEG, "TCP_SEG" },
+#endif
+#endif
+#if LWIP_ARP
+		{ MEMP_ARP_QUEUE, "ARPQ" },
+#endif
+		{ MEMP_NETBUF, "NETBUF" },
+		{ -1, NULL },
+	};
+	int i;
+
+	for (i = 0; pools[i].name; i++) {
+		struct stats_mem *m = lwip_stats.memp[pools[i].idx];
+
+		if (!m)
+			continue;
+		uk_pr_info("UKGDIAG pool %s used=%lu max=%lu err=%u\n",
+			   pools[i].name, (unsigned long)m->used,
+			   (unsigned long)m->max, (unsigned)m->err);
+	}
+#endif /* LWIP_STATS && MEMP_STATS */
+}
+
+/* --- Decisive-run additions (ticket 4ecf9dcedf): poll-thread
+ * liveness, tcpip mailbox pending, tcpip thread state, listener and
+ * pcb-state census. All TEMP, removed with LWIP_UKG_DIAG.
+ */
+
+/* Mirror of the ukmpi mailbox internals (lib/ukmpi/mbox_defs.h).
+ * Read-only forensic view. pending = slots between readpos and
+ * writepos on the ring of m->len slots.
+ */
+struct ukg_mbox_mirror {
+	size_t len;
+	struct uk_semaphore readsem;
+	long readpos;
+	struct uk_semaphore writesem;
+	long writepos;
+};
+
+/* Accessor added by lib-lwip patch
+ * patches/0019-ukg-diag-tcpip-accessor.patch.
+ */
+extern sys_mbox_t *ukg_diag_tcpip_mbox(void);
+
+static void ukg_diag_print_rxpath(void)
+{
+	sys_mbox_t *mb;
+	struct ukg_mbox_mirror *m;
+	unsigned long pend = 0, cap = 0;
+	struct uk_sched *s;
+	struct uk_thread *t, *tcpip = NULL;
+	unsigned long nthr = 0;
+	const char *tstate;
+
+	s = uk_sched_current();
+	if (s) {
+		UK_TAILQ_FOREACH(t, &s->thread_list, thread_list) {
+			nthr++;
+			if (t->name && !strncmp(t->name, TCPIP_THREAD_NAME,
+						sizeof(TCPIP_THREAD_NAME)))
+				tcpip = t;
+		}
+	}
+	if (!tcpip)
+		tstate = "absent";
+	else if (uk_thread_is_exited(tcpip))
+		tstate = "exited";
+	else if (uk_thread_is_runnable(tcpip))
+		tstate = "run";
+	else
+		tstate = "blk";
+
+	mb = ukg_diag_tcpip_mbox();
+	if (mb && mb->valid && mb->mbox) {
+		m = (struct ukg_mbox_mirror *) mb->mbox;
+		if (m->len > 0) {
+			cap = (unsigned long) (m->len - 1);
+			pend = (unsigned long) ((m->writepos - m->readpos +
+						 (long) m->len) %
+						(long) m->len);
+		}
+	}
+
+	uk_pr_info("UKGDIAG rxpath pass=%llu empty=%llu tcpip=%s mbox=%lu/%lu thr=%lu\n",
+		   (unsigned long long) ukg_diag_poll_passes,
+		   (unsigned long long) ukg_diag_poll_empty,
+		   tstate, pend, cap, nthr);
+}
+
+#if LWIP_TCP && !LWIP_PERCORE
+static void ukg_diag_print_tcp(void)
+{
+	struct tcp_pcb_listen *lpcb;
+	struct tcp_pcb *pcb;
+	unsigned long lsn = 0, act = 0, synrecv = 0, estab = 0, tw = 0;
+	unsigned int lport = 0;
+
+	for (lpcb = tcp_listen_pcbs.listen_pcbs; lpcb;
+	     lpcb = (struct tcp_pcb_listen *) lpcb->next) {
+		lsn++;
+		/* This fork keeps local_port in host order (verified
+		 * on the host: raw value is 80). No byte swap.
+		 */
+		lport = lpcb->local_port;
+	}
+	for (pcb = tcp_active_pcbs; pcb; pcb = pcb->next) {
+		act++;
+		if (pcb->state == SYN_RCVD)
+			synrecv++;
+		else if (pcb->state == ESTABLISHED)
+			estab++;
+	}
+	for (pcb = tcp_tw_pcbs; pcb; pcb = pcb->next)
+		tw++;
+
+	uk_pr_info("UKGDIAG tcp lsn=%lu port=%u act=%lu synrecv=%lu estab=%lu tw=%lu\n",
+		   lsn, lport, act, synrecv, estab, tw);
+}
+#endif /* LWIP_TCP && !LWIP_PERCORE */
+
+/* Install one static ARP entry per configured peer. Returns 1 when
+ * the gateway is known and the pass ran, 0 when it must run again. */
+static int ukg_diag_add_static_arps(struct netif *nf)
+{
+	const ip4_addr_t *gw;
+	struct eth_addr gw_mac;
+	int i;
+
+	if (!nf)
+		return 0;
+	gw = netif_ip4_gw(nf);
+	if (!gw || ip4_addr_isany_val(*gw))
+		return 0;
+
+	gw_mac.addr[0] = 0x42;
+	gw_mac.addr[1] = 0x01;
+	gw_mac.addr[2] = ip4_addr1(gw);
+	gw_mac.addr[3] = ip4_addr2(gw);
+	gw_mac.addr[4] = ip4_addr3(gw);
+	gw_mac.addr[5] = ip4_addr4(gw);
+
+	uk_pr_info("UKGDIAG gw %s -> MAC 42:01:%02x:%02x:%02x:%02x\n",
+		   ip4addr_ntoa(gw), gw_mac.addr[2], gw_mac.addr[3],
+		   gw_mac.addr[4], gw_mac.addr[5]);
+
+	for (i = 0; i < UKG_DIAG_MAXPEERS; i++) {
+		ip4_addr_t peer;
+
+		if (!diagpeers[i])
+			continue;
+		if (ip4addr_aton(diagpeers[i], &peer) != 1) {
+			uk_pr_warn("UKGDIAG unparsable peer %s\n",
+				   diagpeers[i]);
+			continue;
+		}
+		if (etharp_add_static_entry(&peer, &gw_mac) == ERR_OK)
+			uk_pr_info("UKGDIAG ARP-STATIC ok %s\n",
+				   diagpeers[i]);
+		else
+			uk_pr_warn("UKGDIAG ARP-STATIC fail %s\n",
+				   diagpeers[i]);
+	}
+	return 1;
+}
+
+static __noreturn void ukg_diag_thread(void *arg __unused)
+{
+	struct netif *nf;
+	unsigned int static_done = 0;
+	uint64_t seq = 0;
+
+	uk_pr_info("UKGDIAG thread started (ticket 4ecf9dcedf)\n");
+
+	while (1) {
+		uk_semaphore_down_to(&nap,
+			ukplat_monotonic_clock() +
+			ukarch_time_sec_to_nsec(UKG_DIAG_PERIOD_SEC));
+
+		nf = netif_default;
+
+		uk_pr_info("UKGDIAG #%"PRIu64" t=%"PRIu64"s netif=%c%c%u up=%u link=%u rx=%"PRIu64" rb=%"PRIu64" rxd=%"PRIu64" rxst=%"PRIu64" tx=%"PRIu64" tb=%"PRIu64" txe=%"PRIu64"\n",
+			   seq,
+			   (uint64_t)(ukplat_monotonic_clock() /
+				      1000000000ULL),
+			   nf ? nf->name[0] : '-', nf ? nf->name[1] : '-',
+			   nf ? (unsigned)nf->num : 0U,
+			   nf ? (netif_is_up(nf) ? 1U : 0U) : 0U,
+			   nf ? (netif_is_link_up(nf) ? 1U : 0U) : 0U,
+			   ukg_diag_rx_pkts, ukg_diag_rx_bytes,
+			   ukg_diag_rx_drop, ukg_diag_rx_stall,
+			   ukg_diag_tx_pkts, ukg_diag_tx_bytes,
+			   ukg_diag_tx_err);
+
+		if (!static_done && nf)
+			static_done = (unsigned int)
+				ukg_diag_add_static_arps(nf);
+
+		ukg_diag_print_rxpath();
+#if LWIP_TCP && !LWIP_PERCORE
+		ukg_diag_print_tcp();
+#endif
+		ukg_diag_print_pools();
+		seq++;
+	}
+}
+
+static int ukg_diag_init(struct uk_init_ctx *ictx __unused)
+{
+	struct uk_sched *sched;
+
+	uk_semaphore_init(&nap, 0);
+	/* Same scheduler handle source as threads.c sys_thread_new:
+	 * ukboot runs library init calls on a scheduler context. */
+	sched = uk_sched_current();
+	if (!sched) {
+		uk_pr_warn("UKGDIAG: no primary scheduler; forensics off\n");
+		return 0;
+	}
+	if (!uk_sched_thread_create(sched, ukg_diag_thread, NULL, NULL))
+		uk_pr_warn("UKGDIAG: cannot create thread; forensics off\n");
+	return 0;
+}
+uk_lib_initcall(ukg_diag_init, 0);
+
+#endif /* CONFIG_LWIP_UKG_DIAG */
