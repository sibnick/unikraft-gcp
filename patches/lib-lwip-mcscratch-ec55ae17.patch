From: nikolay <nikolay@localhost>
Subject: [PATCH] lib-lwip: add 0018 per-core tcp_input and ip_data scratch

Add numbered patch 0018 to the lib-lwip patch set. tcp_input keeps
the segment scratch (inseg, tcphdr, seqno, ackno, flags, recv_data)
and ip_data the packet addresses in shared statics. Under
LWIP_PERCORE concurrent cores cross-overwrite them, so a receive
pbuf reaches two owners and pbuf_free trips its refcount assert.
Give each core its own copies. This is the root-cause fix for the
MC cloud gate crash (runs 2..5). [Ticket 3dc1f3f6b6]

--- /dev/null
+++ b/patches/0018-per-core-input-scratch.patch
@@ -0,0 +1,1494 @@
+From: nikolay <nikolay@localhost>
+Subject: [PATCH 0018] tcp_in, ip: make the input path scratch per core
+
+tcp_input() keeps the segment scratch (inseg, tcphdr, seqno, ackno,
+flags, tcplen, recv_flags, recv_data, option cursors) in file-scope
+statics, and ip_data holds the addresses of the packet being
+processed. Patch 0016 made the pcb lists and timers per core but
+never these. With LWIP_PERCORE every core runs tcp_input() at the
+same time, so one core overwrites another core's scratch mid-packet.
+A receive pbuf then reaches two owners and pbuf_free() trips the
+refcount assert (cloud runs 2..5). Give each core its own
+tcp_in_scratch table and its own ip_globals. Uses in tcp_in.c carry
+an sc_ prefix so the names cannot collide with struct members such
+as tcphdr->seqno or pcb->flags. Non-per-core builds keep one shared
+instance. [Ticket 3dc1f3f6b6]
+
+--- a/src/core/tcp_in.c
++++ b/src/core/tcp_in.c
+@@ -70,20 +70,75 @@
+ 
+ /* These variables are global to all functions involved in the input
+    processing of TCP segments. They are set by the tcp_input()
+-   function. */
+-static struct tcp_seg inseg;
+-static struct tcp_hdr *tcphdr;
+-static u16_t tcphdr_optlen;
+-static u16_t tcphdr_opt1len;
+-static u8_t *tcphdr_opt2;
+-static u16_t tcp_optidx;
+-static u32_t seqno, ackno;
+-static tcpwnd_size_t recv_acked;
+-static u16_t tcplen;
+-static u8_t flags;
++   function. [Ticket 3dc1f3f6b6] With LWIP_PERCORE every core runs
++   tcp_input() on its own packets at the same time. One shared copy
++   of this segment scratch lets one core overwrite another core's
++   view mid-packet: the receive pbuf of one connection can then be
++   freed by two owners and pbuf_free() trips its refcount assert.
++   Keep one scratch area per core. The uses below carry an sc_
++   prefix so the names cannot collide with struct members such as
++   tcphdr->seqno or pcb->flags. */
++struct tcp_in_scratch {
++  struct tcp_seg inseg;
++  struct tcp_hdr *tcphdr;
++  u16_t tcphdr_optlen;
++  u16_t tcphdr_opt1len;
++  u8_t *tcphdr_opt2;
++  u16_t tcp_optidx;
++  u32_t seqno, ackno;
++  tcpwnd_size_t recv_acked;
++  u16_t tcplen;
++  u8_t flags;
++  u8_t recv_flags;
++  struct pbuf *recv_data;
++};
++
++#if LWIP_PERCORE
++#include "lwip_percore.h"
++static struct tcp_in_scratch tcp_in_scratch[LWIP_CORE_MAX];
+ 
+-static u8_t recv_flags;
+-static struct pbuf *recv_data;
++static inline struct tcp_in_scratch *
++tcp_in_sc(void)
++{
++  return &tcp_in_scratch[lwip_current_core_id()];
++}
++
++#define sc_inseg          (tcp_in_sc()->inseg)
++#define sc_tcphdr         (tcp_in_sc()->tcphdr)
++#define sc_tcphdr_optlen  (tcp_in_sc()->tcphdr_optlen)
++#define sc_tcphdr_opt1len (tcp_in_sc()->tcphdr_opt1len)
++#define sc_tcphdr_opt2    (tcp_in_sc()->tcphdr_opt2)
++#define sc_tcp_optidx     (tcp_in_sc()->tcp_optidx)
++#define sc_seqno          (tcp_in_sc()->seqno)
++#define sc_ackno          (tcp_in_sc()->ackno)
++#define sc_recv_acked     (tcp_in_sc()->recv_acked)
++#define sc_tcplen         (tcp_in_sc()->tcplen)
++#define sc_flags          (tcp_in_sc()->flags)
++#define sc_recv_flags     (tcp_in_sc()->recv_flags)
++#define sc_recv_data      (tcp_in_sc()->recv_data)
++#else /* LWIP_PERCORE */
++static struct tcp_in_scratch tcp_in_scratch_one;
++
++static inline struct tcp_in_scratch *
++tcp_in_sc(void)
++{
++  return &tcp_in_scratch_one;
++}
++
++#define sc_inseg          (tcp_in_sc()->inseg)
++#define sc_tcphdr         (tcp_in_sc()->tcphdr)
++#define sc_tcphdr_optlen  (tcp_in_sc()->tcphdr_optlen)
++#define sc_tcphdr_opt1len (tcp_in_sc()->tcphdr_opt1len)
++#define sc_tcphdr_opt2    (tcp_in_sc()->tcphdr_opt2)
++#define sc_tcp_optidx     (tcp_in_sc()->tcp_optidx)
++#define sc_seqno          (tcp_in_sc()->seqno)
++#define sc_ackno          (tcp_in_sc()->ackno)
++#define sc_recv_acked     (tcp_in_sc()->recv_acked)
++#define sc_tcplen         (tcp_in_sc()->tcplen)
++#define sc_flags          (tcp_in_sc()->flags)
++#define sc_recv_flags     (tcp_in_sc()->recv_flags)
++#define sc_recv_data      (tcp_in_sc()->recv_data)
++#endif /* LWIP_PERCORE */
