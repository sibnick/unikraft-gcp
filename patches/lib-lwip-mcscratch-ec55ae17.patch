+-
+-  flags = TCPH_FLAGS(tcphdr);
+-  tcplen = p->tot_len;
+-  if (flags & (TCP_FIN | TCP_SYN)) {
+-    tcplen++;
+-    if (tcplen < p->tot_len) {
++  sc_tcphdr->src = lwip_ntohs(sc_tcphdr->src);
++  sc_tcphdr->dest = lwip_ntohs(sc_tcphdr->dest);
++  sc_seqno = sc_tcphdr->seqno = lwip_ntohl(sc_tcphdr->seqno);
++  sc_ackno = sc_tcphdr->ackno = lwip_ntohl(sc_tcphdr->ackno);
++  sc_tcphdr->wnd = lwip_ntohs(sc_tcphdr->wnd);
