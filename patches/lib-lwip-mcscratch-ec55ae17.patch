+ #if !LWIP_PERCORE
+ struct tcp_pcb *tcp_input_pcb;
+@@ -137,10 +192,10 @@
+   TCP_STATS_INC(tcp.recv);
+   MIB2_STATS_INC(mib2.tcpinsegs);
